[Unit]
Description=BlueALSA Bluetooth Audio service (A2DP Source) [DEPRECATED: PipeWire cutover]
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStartPre=/bin/bash -lc 'for i in {1..20}; do timeout 2 bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/bluealsad -p a2dp-source --codec=SBC --keep-alive=600 --sbc-quality=high --io-rt-priority=20
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
